# Path to the SBD library
SBD_PATH=../..

# mpi c++ compiler (brew open-mpi wraps Apple clang)
CCCOM=$(if $(MPICC),$(MPICC),mpicxx)

# macOS / Apple clang: OpenMP via brew libomp (needs -Xpreprocessor -fopenmp),
# BLAS/LAPACK via the built-in Accelerate framework.
CCFLAGS= -std=c++17 -O3 -Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include

# link: Accelerate for BLAS/LAPACK, libomp for OpenMP runtime.
SYSLIB= -framework Accelerate -L/opt/homebrew/opt/libomp/lib -lomp

